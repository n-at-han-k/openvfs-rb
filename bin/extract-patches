#!/bin/sh
# Submodule working tree -> patches/, one patch per changed file. Read-only on the
# submodule; diffs against HEAD so staged changes are included.
set -e
cd "$(dirname "$0")/.."

rm -rf patches
git -C opencloud-desktop diff HEAD --name-only | while read -r file; do
	mkdir -p "patches/$(dirname "$file")"
	git -C opencloud-desktop diff HEAD -- "$file" > "patches/$file.patch"
	echo "$file"
done
