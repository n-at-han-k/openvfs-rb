#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the MIT License.
# Copyright, 2026, by Nathan Kidd.

# PACKAGE-PLATFORM-GEM(1)            General Commands Manual          PACKAGE-PLATFORM-GEM(1)
#
# NAME
#      bin/package-platform-gem — build one precompiled platform gem from the objects in ext/
#
# SYNOPSIS
#      bin/package-platform-gem PLATFORM [OBJECTS_DIR]
#
# DESCRIPTION
#      Builds pkg/openvfs-rb-X.Y.Z-PLATFORM.gem from the objects under OBJECTS_DIR, which
#      holds one directory per Ruby ABI - OBJECTS_DIR/3.4/occ.so and so on. PLATFORM is a
#      RubyGems platform such as x86_64-linux or arm64-darwin. OBJECTS_DIR defaults to
#      ./objects.
#
#      This runs in CI, once per platform, after every ABI for that platform has been built. The
#      Cross Compile workflow uploads the gem it produces, so what the release downloads is
#      already a gem. That is how vodozemac-rb works - its oxidize-rb/actions/cross-gem step
#      builds the platform gem in the job - and it is why bin/release-gem does nothing but
#      push: a gem's filename carries its version, so there is no question of which release
#      a downloaded artifact belongs to.
#
#      A platform gem is the ordinary gemspec with three changes: the platform is set, the
#      extensions are cleared so that RubyGems unpacks instead of compiling, and the Ruby
#      requirement is the range RUBY_ABIS covers.
#
#      One object per Ruby ABI is the whole point, and it is why nothing here sets
#      required_rubygems_version. A compiled object only loads on the Ruby it was built for,
#      so a gem built for one ABI has to say so - and then name, version and platform no
#      longer identify it, since the same three could describe a build for another ABI.
#      Disambiguating those is what rubygems.org's content-addressable scheme is for, and
#      pushing into it is refused unless required_rubygems_version is ">= 4.1.0.a" - a
#      prerelease floor almost nothing meets, which is why 1.1.0's platform gems were
#      published but never selected. Covering a range of ABIs instead sidesteps all of it,
#      which is what vodozemac-rb does: one gem per platform, one object per ABI inside.
#
# EXIT STATUS
#      The bin/package-platform-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/release-gem(1), gem(1), .github/workflows/cross-compile.yml
#
# openvfs-rb                            October 29, 2026         PACKAGE-PLATFORM-GEM(1)

require_relative "../lib/openvfs/rb/version"
require "fileutils"
require "rubygems/package"

$stdout.sync = true

root = File.expand_path("..", __dir__)
Dir.chdir(root)

# An object only loads on the Ruby ABI it was compiled against, so a platform gem carries one per ABI and lib/openvfs.rb picks by RUBY_VERSION. Covering a range is also what keeps the gem out of rubygems.org's content-addressable scheme: name, version and platform identify it on their own, so no `required_rubygems_version` floor is needed. Pinning one ABI is what forced the ">= 4.1.0.a" floor that made 1.1.0's platform gems unselectable.
# Each ABI listed here has to be a directory under the objects root, and the workflow builds one per entry.
RUBY_ABIS = ["3.3", "3.4", "4.0"].freeze

# The range the ABIs above cover. The upper bound is exclusive of the next ABI after the last one built.
RUBY_REQUIREMENT = [">= #{RUBY_ABIS.first}", "< 4.1.dev"].freeze

gem_platform = ARGV.first

if gem_platform.nil? || gem_platform.start_with?("-")
  abort "usage: bin/package-platform-gem PLATFORM [OBJECTS_DIR]"
end

# Where the per-ABI objects are: OBJECTS_DIR/<abi>/openvfs.<dlext> and OBJECTS_DIR/<abi>/occ.<dlext>. The workflow builds into one directory per ABI and passes the root.
objects_root = ARGV[1] || "objects"

unless File.directory?(objects_root)
  abort "ERROR: #{objects_root} is not a directory; build the objects before packaging."
end

gemspec = "openvfs-rb.gemspec"
pkg_dir = "pkg"
source_spec = Gem::Specification.load(gemspec)

if source_spec.nil?
  abort "ERROR: could not load #{gemspec}"
end

FileUtils.mkdir_p(pkg_dir)

staging = File.join(pkg_dir, "stage-#{gem_platform}")

FileUtils.rm_rf(staging)
FileUtils.mkdir_p(staging)

# Everything the source gem ships except the extension sources, which a precompiled gem has no use for. The gemspec globs with FNM_DOTMATCH, so its list holds directory entries too.
carried = source_spec.files.reject{|path| path.start_with?("ext/")}.select{|path| File.file?(path)}

carried.each do |path|
  destination = File.join(staging, path)

  FileUtils.mkdir_p(File.dirname(destination))
  FileUtils.cp(path, destination)
end

# Into the ABI directories the requires ask for: lib/openvfs.rb does `require_relative "openvfs/3.4/openvfs"` and lib/openvfs/occ.rb does `require_relative "occ/3.4/occ"`.
staged = []

RUBY_ABIS.each do |abi|
  # Whatever that ABI's job built: the Windows gem has occ alone, because upstream ships no Windows build of libopenvfs.
  openvfs_object = Dir["#{objects_root}/#{abi}/openvfs.{so,bundle}"].first
  occ_object = Dir["#{objects_root}/#{abi}/occ.{so,bundle}"].first

  if occ_object.nil?
    abort "ERROR: #{objects_root}/#{abi} holds no occ object; every ABI in RUBY_ABIS has to be built, or the gem would claim a Ruby it cannot load on."
  end

  dlext = File.extname(occ_object).delete_prefix(".")

  {"openvfs/#{abi}/openvfs" => openvfs_object, "openvfs/occ/#{abi}/occ" => occ_object}.each do |stem, object|
    if object.nil?
      next
    end

    relative = "lib/#{stem}.#{dlext}"
    destination = File.join(staging, relative)

    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.cp(object, destination)
    staged << relative
  end
end

spec = source_spec.dup
spec.platform = Gem::Platform.new(gem_platform)
spec.extensions = []
spec.required_ruby_version = RUBY_REQUIREMENT
spec.files = carried + staged

built = Dir.chdir(staging){Gem::Package.build(spec)}
produced = File.join(pkg_dir, built)

FileUtils.mv(File.join(staging, built), produced)
FileUtils.rm_rf(staging)

puts "#{produced}  (#{staged.join(', ')})"
