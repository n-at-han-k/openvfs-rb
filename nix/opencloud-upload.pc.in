prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/opencloud-upload

Name: opencloud-upload
Description: OpenCloud Desktop account and PUTFileJob subset
Version: @MIRALL_VERSION@
Requires: Qt6Core Qt6Gui Qt6Network
Libs: -L${libdir} -lopencloud-upload
Cflags: -I${includedir} -I${includedir}/libsync -DOPENVFS_OCC_UPLOAD_ONLY -DOPENCLOUD_BUILT_AS_STATIC -DQT_NO_KEYWORDS
