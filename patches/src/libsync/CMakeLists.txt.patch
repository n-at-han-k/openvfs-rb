+# src/gui headers include "gui/opencloudguilib.h"; upstream generates it from the
+# OpenCloudGui target, which this build does not have. Alias it onto our own macro.
+file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/gui")
+file(WRITE "${CMAKE_BINARY_DIR}/generated/gui/opencloudguilib.h"
+    "#pragma once\n#include \"libsync/opencloudsynclib.h\"\n#define OPENCLOUD_GUI_EXPORT OPENCLOUD_SYNC_EXPORT\n")
+
+# The public headers include qt6keychain/keychain.h, and QtKeychain ships no
+# pkg-config file, so bake its paths into ours for extconf.
+set(QTKEYCHAIN_INCLUDE_DIR "${QTKEYCHAIN_INCLUDE_DIRS}")
+get_filename_component(_qtkeychain_prefix "${Qt6Keychain_DIR}/../../.." ABSOLUTE)
+set(QTKEYCHAIN_LIBDIR "${_qtkeychain_prefix}/lib")
+
+configure_file(
+    "${CMAKE_SOURCE_DIR}/opencloud-upload.pc.in"
+    "${CMAKE_BINARY_DIR}/opencloud-upload.pc"
+    @ONLY
+)
 
