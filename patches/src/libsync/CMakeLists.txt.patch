+set(OPENCLOUD_UPLOAD_PC_QT_LIBS "")
+if(OPENCLOUD_UPLOAD_QT6_PC_FOUND)
+    set(_pc_requires "")
+    foreach(_module IN LISTS OPENCLOUD_UPLOAD_PC_QT_MODULES)
+        string(APPEND _pc_requires "Qt6${_module} ")
+    endforeach()
+    set(OPENCLOUD_UPLOAD_PC_REQUIRES "${_pc_requires}sqlite3")
+else()
+    set(OPENCLOUD_UPLOAD_PC_REQUIRES "sqlite3")
+    get_target_property(_qt_core_implib Qt6::Core IMPORTED_IMPLIB_RELEASE)
+    if(NOT _qt_core_implib)
+        get_target_property(_qt_core_implib Qt6::Core IMPORTED_LOCATION_RELEASE)
+    endif()
+    get_filename_component(_qt_libdir "${_qt_core_implib}" DIRECTORY)
+    string(APPEND OPENCLOUD_UPLOAD_PC_QT_LIBS " -L${_qt_libdir}")
+
+    foreach(_module IN LISTS OPENCLOUD_UPLOAD_PC_QT_MODULES)
+        get_target_property(_includes Qt6::${_module} INTERFACE_INCLUDE_DIRECTORIES)
+        foreach(_include IN LISTS _includes)
+            # Imported Qt targets can carry genex-wrapped entries; those are build-tree
+            # paths that mean nothing to a consumer.
+            if(NOT _include MATCHES "\\$<")
+                string(APPEND OPENCLOUD_UPLOAD_PC_QT_CFLAGS " -I${_include}")
+            endif()
+        endforeach()
+        string(APPEND OPENCLOUD_UPLOAD_PC_QT_LIBS " -lQt6${_module}")
+    endforeach()
 endif()
 
